{
  "manifest_version": 3,
  "name": "TRUCKR CoWork",
  "version": "1.0.0",
  "description": "TRUCKR CoWork: one-click replies to carriers asking about YOUR DAT and Truckstop loads, cross-checked with YOUR Salesforce loads. Every trailer type, reefer temps, hazmat, pallets, dims and reference #s.",
  "permissions": ["storage", "management", "alarms", "tabs", "scripting", "cookies", "offscreen", "declarativeNetRequest"],
  "host_permissions": [
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://outlook.live.com/*",
    "https://outlook.cloud.microsoft/*",
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*",
    "https://*.my.salesforce.com/*",
    "https://*.dat.com/*",
    "https://*.truckstop.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://outlook.office.com/*", "https://outlook.office365.com/*", "https://outlook.live.com/*", "https://outlook.cloud.microsoft/*"],
      "js": ["lib/truckr.js", "content/outlook.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://one.dat.com/*"],
      "js": ["content/dat-main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://one.dat.com/*", "https://main.truckstop.com/*", "https://app.truckstop.com/*"],
      "js": ["content/board.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TRUCKR CoWork",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "truckr-reply": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "TRUCKR CoWork: reply to the carrier email that's open"
    }
  }
}
